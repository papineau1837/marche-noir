{
  "expo": {
    "name": "Marché Noir",
    "slug": "marche-noir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0a0a0a",
      "resizeMode": "contain",
      "dark": {
        "backgroundColor": "#0a0a0a"
      },
      "light": {
        "backgroundColor": "#0a0a0a"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cette application a besoin d'accéder à votre galerie pour le partage.",
        "NSMicrophoneUsageDescription": "Cette application a besoin d'accéder au micro pour les notifications vocales."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.marchenoir.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}